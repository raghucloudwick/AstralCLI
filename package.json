{
  "name": "astral-cli",
  "version": "1.0.0",
  "description": "CLI tool for Astral UI components",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "astral-cli": "./dist/index.js"
  },
  "scripts": {
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": [
    "astral-ui",
    "cli",
    "components"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@floating-ui/react": "^0.27.7",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/react-virtual": "^3.13.6",
    "@types/node-fetch": "^2.6.12",
    "chalk": "^5.4.1",
    "clsx": "^2.1.1",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0",
    "inquirer": "^12.5.2",
    "node-fetch": "^2.7.0",
    "react-merge-refs": "^2.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
